# Synapse runtime configuration (copy to docker/.env and fill in secrets)

DATABASE_URL=postgresql://admin:88888888@postgres:5432/synapse
OLLAMA_URL=http://host.docker.internal:11434
API_HOST=0.0.0.0
API_PORT=8420
SYNAPSE_SCAN_INTERVAL=600
SYNAPSE_RECONCILE_HOUR=2

# OpenRouter LLM (fallback to Ollama when unavailable)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_TIMEOUT=60

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
